# ⚠️  Do NOT ship these defaults to production. Run ./install.sh instead — it
#     generates random Postgres credentials and a real encryption key for you.

POSTGRES_DB=pasatrader
POSTGRES_USER=pasatrader
POSTGRES_PASSWORD=pasatrader
DATABASE_URL=postgres://pasatrader:pasatrader@localhost:55432/pasatrader

# Set to true when serving over HTTPS in production.
AUTH_COOKIE_SECURE=false

# Generate with: openssl rand -base64 32 (install.sh does this for you).
# The app refuses to start with an invalid key.
# ⚠️  BACK THIS UP. If lost, ALL stored broker/model credentials become
#     permanently unreadable. Store it in a password manager.
CREDENTIAL_ENCRYPTION_KEY=REPLACE_ME__run_openssl_rand_base64_32

NEXT_PUBLIC_APP_NAME=Pasa Trader Platform

# Production only: domain for automatic TLS via Caddyfile.prod
# (e.g. trader.example.com). Leave unset for local/dev.
# DOMAIN=

# Optional: shared secret for the Alpaca order-event webhook receiver
# (POST /api/webhooks/alpaca). Leave unset to disable the endpoint.
# ALPACA_WEBHOOK_SECRET=
