# Compose builds the in-network DATABASE_URL from these values (host: postgres).
POSTGRES_DB=pasatrader
POSTGRES_USER=pasatrader
POSTGRES_PASSWORD=pasatrader
# Optional: host-side tools (Prisma CLI on your machine) use localhost via the published port.
DATABASE_URL=postgres://pasatrader:pasatrader@localhost:55432/pasatrader
AUTH_COOKIE_SECURE=false
# Generate with: openssl rand -base64 32 (install.sh does this for you).
# The app refuses to start with an invalid key.
CREDENTIAL_ENCRYPTION_KEY=REPLACE_ME__run_openssl_rand_base64_32
NEXT_PUBLIC_APP_NAME=Pasa Trader Platform
